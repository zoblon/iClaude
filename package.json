    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/luxon": "^3.7.6",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.4",
    "@types/turndown": "^5.0.6",
    "esbuild": "^0.28.2",
