# Development credentials. Copy this file to ".env" and enter your values.
# ".env" is listed in .gitignore and is never committed.

# Apple ID email address (login for Calendar and Contacts)
ICLOUD_APPLE_ID=

# Your @icloud.com address (login for Mail; may differ from the Apple ID)
ICLOUD_MAIL_USER=

# App-specific password (account.apple.com -> Sign-In and Security)
ICLOUD_APP_PASSWORD=

# Optional
ICLOUD_TIMEZONE=Europe/Berlin
ICLOUD_DEFAULT_CALENDAR=MCP-Test
