# Entwicklungs-Zugangsdaten. Kopiere diese Datei nach ".env" und trage deine Werte ein.
# ".env" steht in .gitignore und wird nie committet.

# Apple-ID-Mailadresse (Login für Kalender und Kontakte)
ICLOUD_APPLE_ID=

# Deine @icloud.com-Adresse (Login für Mail; kann von der Apple-ID abweichen)
ICLOUD_MAIL_USER=

# App-spezifisches Passwort (account.apple.com -> Anmeldung und Sicherheit)
ICLOUD_APP_PASSWORD=

# Optional
ICLOUD_TIMEZONE=Europe/Berlin
ICLOUD_DEFAULT_CALENDAR=MCP-Test
